+/* one of the selections OSC 52 may name: clipboard, primary, secondary, select, cut buffers 0 to 7 */
+static bool is_clipboard_selection( wchar_t c )
+{
+  return c == L'c' || c == L'p' || c == L'q' || c == L's' || ( c >= L'0' && c <= L'7' );
+}
