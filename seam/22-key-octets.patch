+Base64Key Base64Key::of_octets( const std::string& octets )
+{
+  if ( octets.size() != 16 ) {
+    throw CryptoException( "Key must represent 16 octets." );
+  }
+  Base64Key made { Octets {} };
+  memcpy( made.key, octets.data(), 16 );
+  return made;
+}
