+++ b/src/network/imp/transport-test.cc
@@ -0,0 +1,71 @@
+/* Copyright 2026 Warren D. MacEvoy. GPL-3.0-or-later. See github.com/wmacevoy/gosh/LICENSE-GOSH, and LICENSE-MOSH. */
+/* A test of the core's, added by gosh's seam 19: the core's own behaviour, which the seam's factoring of it into
+   domains must not change (REQ21/SHAPE-1: "no byte of the protocol changes, and no behaviour"). */
+
+#include <string>
+#include <vector>
+
+#include "src/network/imp/compressor.h"
+#include "src/network/imp/transportfragment.h"
+#include "src/network/network.h"
+#include "src/protobufs/transportinstruction.pb.h"
+#include "vendor/facts/facts.h"
+
+using Network::Imp::Fragment;
+
+/* REQ21/SHAPE-1: the transport's fragments, compression and port ranges */
+FACTS( Transport )
+{
+  TransportBuffers::Instruction inst;
+  inst.set_protocol_version( 2 );
+  inst.set_old_num( 7 );
+  inst.set_new_num( 8 );
+  inst.set_ack_num( 6 );
+  inst.set_throwaway_num( 5 );
+  std::string diff;
+  uint32_t x = 12345;
+  for ( int i = 0; i < 3000; i++ ) {
+    x = x * 1103515245 + 12345; /* (bytes that do not compress away, the same each run) */
+    diff.push_back( static_cast<char>( x >> 24 ) );
+  }
+  inst.set_diff( diff );
+
+  Network::Imp::Fragmenter fragmenter;
+  std::vector<Fragment> fragments = fragmenter.make_fragments( inst, 500 );
+  bool small = !fragments.empty();
+  for ( size_t i = 0; i < fragments.size(); i++ ) {
+    small = small && fragments[i].tostring().size() <= 500;
+  }
+  FACT_CHECK( ( fragments.size() > 1 && small ), "an instruction larger than the MTU is made into fragments, each no larger than it" );
+  FACT_CHECK( ( fragments.back().final && !fragments.front().final ), "and only the last is final" );
+
+  Fragment again( fragments[0].tostring() );
+  FACT_CHECK( again == fragments[0], "a fragment's bytes read back as the same fragment" );
+
+  Network::Imp::FragmentAssembly assembly;
+  bool whole = false;
+  for ( size_t i = fragments.size(); i-- > 0; ) { /* (they may arrive in any order) */
+    Fragment f( fragments[i].tostring() );
+    whole = assembly.add_fragment( f );
+  }
+  FACT_CHECK( ( whole && assembly.get_assembly().SerializeAsString() == inst.SerializeAsString() ), "the fragments, out of order, are put together as the instruction they were made of" );
+
+  Network::Imp::Compressor compressor;
+  const std::string text( 4000, 'x' );
+  const std::string packed = compressor.compress_str( text );
+  FACT_CHECK( ( packed.size() < text.size() && compressor.uncompress_str( packed ) == text ), "what is compressed is smaller, and is uncompressed as it was" );
+
+  int low, high;
+  FACT_CHECK( ( Network::Connection::parse_portrange( "60001", low, high ) && low == 60001 && high == 60001 ), "a port is a range of one" );
+  FACT_CHECK( ( Network::Connection::parse_portrange( "60001:60010", low, high ) && low == 60001 && high == 60010 ), "a range, low:high" );
+  FACT_CHECK( !Network::Connection::parse_portrange( "60010:60001", low, high ), "low above high is refused" );
+  FACT_CHECK( !Network::Connection::parse_portrange( "0:5", low, high ), "a range from 0 is refused" );
+  FACT_CHECK( ( !Network::Connection::parse_portrange( "70000", low, high ) && !Network::Connection::parse_portrange( "12x", low, high ) ), "a port past 65535, or not a number, is refused" );
+}
+
+FACTS_REGISTER_ALL()
+{
+  FACTS_REGISTER( Transport );
+}
+
+FACTS_MAIN
