+/* Copyright 2026 Warren D. MacEvoy. GPL-3.0-or-later. See github.com/wmacevoy/gosh/LICENSE-GOSH, and LICENSE-MOSH. */
+/* A test of the core's, added by gosh's seam 19: the core's own behaviour, which the seam's factoring of it into
+   domains must not change (REQ21/SHAPE-1: "no byte of the protocol changes, and no behaviour"). */
+
+#include <clocale>
+#include <string>
+
+#include "src/statesync/completeterminal.h"
+#include "src/statesync/user.h"
+#include "vendor/facts/facts.h"
+
+namespace {
+/* What a cell shows, as the core says it, for a cell holding this one letter */
+std::string shown( char letter )
+{
+  Terminal::Cell c( 0 );
+  c.append( letter );
+  return c.debug_contents();
+}
+}
+
+/* REQ21/SHAPE-1: state synchronisation's two objects, each a diff and its application */
+FACTS( StateSync )
+{
+  /* (the core reads and draws text as UTF-8, and its programs refuse to start in any other locale) */
+  const bool utf8 = setlocale( LC_ALL, "C.UTF-8" ) != NULL;
+  FACT_CHECK( utf8, "the locale C.UTF-8 is there to be had" );
+
+  StateSync::UserStream typed, empty, received;
+  typed.push_back( Terminal::Parser::UserByte( 'l' ) );
+  typed.push_back( Terminal::Parser::UserByte( 's' ) );
+  typed.push_back( Terminal::Parser::Resize( 100, 30 ) );
+  FACT_CHECK( typed.size() == 3, "what the user does is kept in order: two keys, a resize" );
+  received.apply_string( typed.diff_from( empty ) );
+  FACT_CHECK( received == typed, "its diff from nothing, applied to nothing, is the same stream" );
+  StateSync::UserStream more = typed;
+  more.push_back( Terminal::Parser::UserByte( '\n' ) );
+  received.apply_string( more.diff_from( typed ) );
+  FACT_CHECK( received == more, "and the diff of one more key brings the other end up to it" );
+
+  StateSync::Complete server( 20, 5 ), client( 20, 5 );
+  server.act( "hello" );
+  FACT_CHECK( client.get_fb().get_cell( 0, 0 )->debug_contents() != shown( 'h' ), "a terminal not written to does not show what was written to the other" );
+  client.apply_string( server.diff_from( client ) );
+  FACT_CHECK( !client.compare( server ), "the diff of one terminal from another makes the other show the same, every cell and the cursor (compare: what differs)" );
+  FACT_CHECK( client.get_fb().get_cell( 0, 0 )->debug_contents() == shown( 'h' ), "and what was written is there, at the top left" );
+}
+
+FACTS_REGISTER_ALL()
+{
+  FACTS_REGISTER( StateSync );
+}
+
+FACTS_MAIN
