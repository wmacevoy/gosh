@@ -0,0 +1,47 @@
+/* Copyright 2026 Warren D. MacEvoy. GPL-3.0-or-later. See github.com/wmacevoy/gosh/LICENSE-GOSH, and LICENSE-MOSH. */
+/* A test of the core's, added by gosh's seam 19: the core's own behaviour, which the seam's factoring of it into
+   domains must not change (REQ21/SHAPE-1: "no byte of the protocol changes, and no behaviour"). */
+
+#include <string>
+
+#include <unistd.h>
+
+#include "src/util/locale_utils.h"
+#include "src/util/swrite.h"
+#include "src/util/timestamp.h"
+#include "vendor/facts/facts.h"
+
+/* REQ21/SHAPE-1: the utilities: a whole write, a timestamp that does not go back, a locale's variable */
+FACTS( Util )
+{
+  int fds[2];
+  FACT_CHECK( pipe( fds ) == 0, "(a pipe to write to)" );
+  const std::string text( 1000, 'w' );
+  FACT_CHECK( Util::swrite( fds[1], text.data(), text.size() ) == 0, "swrite writes all it is given, and says 0" );
+  close( fds[1] );
+  std::string got;
+  char buf[256];
+  ssize_t n;
+  while ( ( n = read( fds[0], buf, sizeof( buf ) ) ) > 0 ) {
+    got.append( buf, n );
+  }
+  close( fds[0] );
+  FACT_CHECK( got == text, "and every byte arrives" );
+
+  Util::freeze_timestamp();
+  const uint64_t first = Util::frozen_timestamp();
+  FACT_CHECK( Util::frozen_timestamp() == first, "a timestamp, once frozen, stays until it is frozen again" );
+  usleep( 20000 );
+  Util::freeze_timestamp();
+  FACT_CHECK( Util::frozen_timestamp() >= first + 10, "and, frozen again 20 ms later, has moved on by about that" );
+
+  FACT_CHECK( Util::LocaleVar( "LC_ALL", "C.UTF-8" ).str() == "LC_ALL=C.UTF-8", "a locale's variable says itself as NAME=value" );
+  FACT_CHECK( Util::LocaleVar( "", "" ).str() == "[no charset variables]", "and none says so" );
+}
+
+FACTS_REGISTER_ALL()
+{
+  FACTS_REGISTER( Util );
+}
+
+FACTS_MAIN
