+/* Copyright 2026 Warren D. MacEvoy. GPL-3.0-or-later. See github.com/wmacevoy/gosh/LICENSE-GOSH, and LICENSE-MOSH. */
+/* A test of the core's, added by gosh's seam 19: the core's own behaviour, which the seam's factoring of it into
+   domains must not change (REQ21/SHAPE-1: "no byte of the protocol changes, and no behaviour"). */
+
+#include <clocale>
+#include <string>
+
+#include "src/terminal/parser.h"
+#include "src/terminal/terminal.h"
+#include "vendor/facts/facts.h"
+
+namespace {
+/* What a cell shows, as the core says it, for a cell holding this one letter */
+std::string shown( char letter )
+{
+  Terminal::Cell c( 0 );
+  c.append( letter );
+  return c.debug_contents();
+}
+}
+
+/* REQ21/SHAPE-1: the terminal: its parser's actions, and what they do to a framebuffer */
+FACTS( Terminal )
+{
+  /* (the core reads and draws text as UTF-8, and its programs refuse to start in any other locale) */
+  const bool utf8 = setlocale( LC_ALL, "C.UTF-8" ) != NULL;
+  FACT_CHECK( utf8, "the locale C.UTF-8 is there to be had" );
+
+  Terminal::Parser::UTF8Parser parser;
+  Terminal::Parser::Actions actions;
+  const std::string text = "ab";
+  for ( size_t i = 0; i < text.size(); i++ ) {
+    parser.input( text[i], actions );
+  }
+  FACT_CHECK( ( actions.size() == 2 && actions[0]->name() == "Print" && actions[0]->ch == L'a' && actions[1]->ch == L'b' ), "two letters are two prints, of those letters" );
+
+  actions.clear();
+  const std::string erase = "\x1b[2J";
+  for ( size_t i = 0; i < erase.size(); i++ ) {
+    parser.input( erase[i], actions );
+  }
+  bool dispatched = false;
+  for ( size_t i = 0; i < actions.size(); i++ ) {
+    dispatched = dispatched || ( actions[i]->name() == "CSI_Dispatch" && actions[i]->ch == L'J' );
+  }
+  FACT_CHECK( dispatched, "ESC [ 2 J is a control sequence, dispatched on its last letter" );
+
+  Terminal::Emulator emulator( 10, 3 );
+  actions.clear();
+  const std::string written = "hi\r\nyo";
+  for ( size_t i = 0; i < written.size(); i++ ) {
+    parser.input( written[i], actions );
+  }
+  for ( size_t i = 0; i < actions.size(); i++ ) {
+    actions[i]->act_on_terminal( &emulator );
+  }
+  const Terminal::Framebuffer& fb = emulator.get_fb();
+  FACT_CHECK( ( fb.get_cell( 0, 0 )->debug_contents() == shown( 'h' ) && fb.get_cell( 0, 1 )->debug_contents() == shown( 'i' )
+                && fb.get_cell( 1, 0 )->debug_contents() == shown( 'y' ) && fb.get_cell( 1, 1 )->debug_contents() == shown( 'o' ) ),
+              "what is printed is in the framebuffer, and CR LF goes to the next row's start" );
+  FACT_CHECK( ( fb.ds.get_cursor_row() == 1 && fb.ds.get_cursor_col() == 2 ), "with the cursor after it" );
+
+  Terminal::Framebuffer titled( 10, 3 );
+  titled.set_window_title( Terminal::Framebuffer::title_type( 1, L't' ) );
+  titled.prefix_window_title( Terminal::Framebuffer::title_type( 2, L'p' ) );
+  FACT_CHECK( titled.get_window_title() == Terminal::Framebuffer::title_type( { L'p', L'p', L't' } ), "a prefix goes before the window's title" );
+}
+
+FACTS_REGISTER_ALL()
+{
+  FACTS_REGISTER( Terminal );
+}
+
+FACTS_MAIN
