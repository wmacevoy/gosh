+/* Copyright 2026 Warren D. MacEvoy. GPL-3.0-or-later. See github.com/wmacevoy/gosh/LICENSE-GOSH, and LICENSE-MOSH. */
+/* A test of the core's, added by gosh's seam 19: the core's own behaviour, which the seam's factoring of it into
+   domains must not change (REQ21/SHAPE-1: "no byte of the protocol changes, and no behaviour"). */
+
+#include <clocale>
+#include <string>
+
+#include "src/frontend/terminaloverlay.h"
+#include "vendor/facts/facts.h"
+
+/* REQ21/SHAPE-1: the client's overlays: a title's prefix, and a notification shown on the framebuffer */
+FACTS( Overlay )
+{
+  /* (the core reads and draws text as UTF-8, and its programs refuse to start in any other locale) */
+  const bool utf8 = setlocale( LC_ALL, "C.UTF-8" ) != NULL;
+  FACT_CHECK( utf8, "the locale C.UTF-8 is there to be had" );
+
+  Terminal::Framebuffer fb( 40, 5 );
+  fb.set_window_title( Terminal::Framebuffer::title_type( { L'v', L'i' } ) );
+  Frontend::Overlay::TitleEngine title;
+  title.set_prefix( L"[gosh] " );
+  title.apply( fb );
+  const Terminal::Framebuffer::title_type& t = fb.get_window_title();
+  FACT_CHECK( std::wstring( t.begin(), t.end() ) == L"[gosh] vi", "the title engine puts its prefix before the window's title" );
+
+  Terminal::Framebuffer plain( 40, 5 ), noted( 40, 5 );
+  Frontend::Overlay::NotificationEngine notifications;
+  notifications.set_notification_string( L"a note", true, false );
+  notifications.apply( noted );
+  bool changed = false;
+  for ( int col = 0; col < 40; col++ ) {
+    changed = changed || *noted.get_cell( 0, col ) != *plain.get_cell( 0, col );
+  }
+  FACT_CHECK( changed, "a notification is drawn on the framebuffer's top row" );
+}
+
+FACTS_REGISTER_ALL()
+{
+  FACTS_REGISTER( Overlay );
+}
+
+FACTS_MAIN
