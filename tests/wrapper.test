#!/bin/sh
# Copyright 2026 Warren D. MacEvoy. GPL-3.0-or-later. See github.com/wmacevoy/gosh/LICENSE-GOSH, and LICENSE-MOSH.

#
# The mosh command, the one built into mosh-client, with a stand-in for ssh
# (fake-ssh.py, which "logs in" to this machine). That is the part of mosh
# every session starts with and no other test runs: the ssh command line,
# learning the server's address each of the three ways, the server's reply,
# and becoming the client.
#
# Requirements: REQ1/CMD-1 (the command, with no Perl), REQ1/CP-7 (--stdio),
# REQ1/CP-1 (mocp there and back), REQ1/PATH-1 (--relay=always: the relay
# started the way ssh starts it).
#
# usage: wrapper.test CLIENT SERVER INPTY [COMMAND COPY]
#   the two programs, and upstream's test helper that runs a command on a
#   terminal of its own (src/tests/inpty in a build of the core), by absolute path;
#   and the command's two names: mosh and mocp for pf.7 (the default), gosh and
#   gocp for gosh (REQ6/NAME-1)
#
# From the fork at mosh-1.4.0-pf.7 (src/tests/wrapper.test). Changed here: the
# programs and the helper are arguments; the locale is set and not searched
# for; and the second pass of every case, against the Perl script, is gone,
# because gosh does not carry that script (requirements, Non-goals). Seen red
# in gosh on 2026-11-13: against upstream's programs, which have no built-in
# command, 10 of its 14 checks fail. The four that passed there asked only that
# something be refused with exit status 1, which a program that refuses
# everything also gives. Since 2026-11-16 each also asks for its message (a
# part of it that gosh's names will not change), and all 14 fail there.
#

[ $# -eq 3 ] || [ $# -eq 5 ] || { printf 'usage: wrapper.test CLIENT SERVER INPTY [COMMAND COPY]\n' >&2; exit 2; }
client=$1
server=$2
inpty=$3
command=${4:-mosh}
copy=${5:-mocp}
LC_ALL=C.UTF-8
export LC_ALL
ssh="python3 $(cd "$(dirname "$0")" && pwd)/fake-ssh.py"

work=$(mktemp -d 2>/dev/null || mktemp -d -t wrapper-test)
trap 'rm -rf "$work"' EXIT
FAKE_SSH_LOG="$work/ssh.log"
export FAKE_SSH_LOG
printf 'a file\n' > "$work/file"

status=0
check() {
    if [ "$2" = ok ]; then
        printf '%-64s ok\n' "$1"
    else
        printf '%-64s FAIL\n' "$1"
        status=1
    fi
}

for which in built-in; do
    mosh="$client $command"
    mocp="$client $copy"

    for how in proxy remote local; do
        said=$(TERM=xterm "$inpty" $mosh --ssh="$ssh" --server="$server" --experimental-remote-ip=$how \
            localhost -- printf 'he%s\n' llo 2>&1)
        check "$which: a terminal session, the address found by \"$how\"" \
            "$(printf '%s\n' "$said" | grep -q hello && echo ok)"
        [ $status = 0 ] || printf '%s\n' "$said" | tail -5
    done

    said=$(printf 'through\n' | $mosh --ssh="$ssh" --server="$server" --stdio localhost tr a-z A-Z 2>&1)
    check "$which: --stdio, as a program would use it in place of ssh" "$([ "$said" = THROUGH ] && echo ok)"

    rm -f "$work/there" "$work/back"
    $mocp -q --ssh="$ssh" --server="$server" "$work/file" "localhost:$work/there" \
        && $mocp -q --ssh="$ssh" --server="$server" "localhost:$work/there" "$work/back"
    check "$which: mocp, there and back" "$(cmp -s "$work/file" "$work/back" && echo ok)"

    # with no UDP at all: the relay is reached by ssh too
    : > "$FAKE_SSH_LOG"
    rm -f "$work/relayed"
    $mocp -q --relay=always --ssh="$ssh" --server="$server" "$work/file" "localhost:$work/relayed"
    check "$which: mocp with the session carried by ssh (--relay=always)" \
        "$(cmp -s "$work/file" "$work/relayed" && grep -q "BatchMode=yes.* relay " "$FAKE_SSH_LOG" && echo ok)"
done

# what only the built-in one has to get right: its own name, and saying no
# names that were dropped are refused or remarked on, not quietly taken for something else
said=$("$server" stun 60000 2>&1 </dev/null)
check "the old name for a meetup is refused, and says the new one" \
    "$([ $? -eq 1 ] && printf '%s\n' "$said" | grep -q meetup && echo ok)"
if [ "$command" = mosh ]; then # (pf.7's: it remarks on its own earlier names; gosh never had them)
    said=$(MOSH_STUN_KEY=x "$client" mosh --version 2>&1)
    check "a dropped variable still set is remarked on" "$(printf '%s\n' "$said" | grep -q MOSH_MEETUP_KEY && echo ok)"
fi
said=$("$client" "$command" --punch=sometimes localhost 2>&1)
check "an unknown --punch is refused, and says so" "$([ $? -eq 1 ] && printf '%s\n' "$said" | grep -q 'punch mode "sometimes"' && echo ok)"
ln -s "$client" "$work/$command"
ln -s "$client" "$work/$copy"
check "under the name $command it is $command" "$("$work/$command" --help | grep -q "^Usage: $command " && echo ok)"
check "under the name $copy it is $copy" "$("$work/$copy" --help | grep -q "^Usage: $copy " && echo ok)"
said=$("$work/$command" --no-such-option localhost 2>&1)
check "an option it does not know is refused, by name" "$([ $? -eq 1 ] && printf '%s\n' "$said" | grep -q 'no-such-option' && echo ok)"
said=$("$work/$copy" "$work/file" "$work/elsewhere" 2>&1)
check "a copy with no other machine in it is refused, and says why" \
    "$([ $? -eq 1 ] && [ ! -e "$work/elsewhere" ] && printf '%s\n' "$said" | grep -q 'has to be another machine' && echo ok)"
said=$("$work/$command" --ssh="$ssh" --server=/nonexistent/mosh-server localhost 2>&1)
check "no server at the other end is an error, not a hang, and says so" \
    "$([ $? -eq 1 ] && printf '%s\n' "$said" | grep -q 'startup message' && echo ok)"

if [ "$command" = gosh ]; then # (pf.7 hands such a word to ssh: the review of item 10, 2026-11-16)
    : > "$FAKE_SSH_LOG"
    said=$("$work/$command" --ssh="$ssh" -- -oProxyCommand=false 2>&1)
    check "a host that begins with - is refused, and ssh is never run with it" \
        "$([ $? -eq 1 ] && [ ! -s "$FAKE_SSH_LOG" ] && printf '%s\n' "$said" | grep -q 'cannot begin with' && echo ok)"
    : > "$FAKE_SSH_LOG"
    said=$("$work/$copy" --ssh="$ssh" -- "$work/file" '-oProxyCommand=false:x' 2>&1)
    check "and a copy's remote end likewise" \
        "$([ $? -eq 1 ] && [ ! -s "$FAKE_SSH_LOG" ] && echo ok)"
    said=$("$server" stun-key 2>&1 </dev/null)
    check "the old word for a meetup's key is refused, and says the new one" \
        "$([ $? -eq 1 ] && printf '%s\n' "$said" | grep -q 'meetup-key --new' && echo ok)"
fi

exit $status
